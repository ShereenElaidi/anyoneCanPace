{
  "name": "anyonecanpace",
  "private": true,
  "version": "1.0.0",
  "description": "A simple RUN/WALK interval timer for volunteer pacers. Part of AnyoneCanRun by Les Stooopids.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "node scripts/dev-cert.ts && HTTPS_DEV=1 vite --host",
    "build": "tsc -b && vite build && node scripts/check-bundle.ts",
    "preview": "vite preview",
    "preview:https": "node scripts/dev-cert.ts && HTTPS_DEV=1 vite preview --host",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "routes": "node scripts/build-routes.ts",
    "map": "node scripts/cut-map.ts",
    "check:bundle": "node scripts/check-bundle.ts"
  },
  "dependencies": {
    "maplibre-gl": "^6.16.0",
    "pmtiles": "^4.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26 <27"
  }
}
